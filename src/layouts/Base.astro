---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { htmlLang, locales, repoUrl, ui, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  page: string;
}

const { locale, title, page } = Astro.props;
const strings = ui[locale];
const absolute = (target: Locale) =>
  new URL(getRelativeLocaleUrl(target, page), Astro.site).href;
---

<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{`${title} · ${strings.siteName}`}</title>
    <link rel="canonical" href={absolute(locale)} />
    {locales.map((target) => (
      <link
        rel="alternate"
        hreflang={htmlLang[target]}
        href={absolute(target)}
      />
    ))}
  </head>
  <body class="site-shell">
    <div class="site-accent" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">
      {strings.skipLink}
    </a>
    <header class="site-header">
      <div class="shell">
        <a class="brand" href={getRelativeLocaleUrl(locale, page)}>
          <picture>
            <source
              srcset="/circuit-lockup-dark.svg"
              media="(prefers-color-scheme: dark)"
            />
            <img
              class="brand-art"
              src="/circuit-lockup-light.svg"
              alt="Vital Courier"
              width="191"
              height="40"
            />
          </picture>
        </a>
        <nav class="language" aria-label={strings.languageNavLabel}>
          {locales.map((target) =>
            target === locale ? (
              <span aria-current="page">
                <abbr
                  title={strings.languageTitles[target]}
                  lang={htmlLang[target]}
                >
                  {strings.languageLabels[target]}
                </abbr>
              </span>
            ) : (
              <a
                href={getRelativeLocaleUrl(target, page)}
                hreflang={htmlLang[target]}
              >
                <abbr
                  title={strings.languageTitles[target]}
                  lang={htmlLang[target]}
                >
                  {strings.languageLabels[target]}
                </abbr>
              </a>
            ),
          )}
        </nav>
      </div>
    </header>
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <a href={repoUrl} aria-label={strings.footerGithubLabel}>
          GitHub
        </a>
      </div>
    </footer>
  </body>
</html>
