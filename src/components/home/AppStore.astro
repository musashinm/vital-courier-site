---
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  url: string;
}

const { locale, url } = Astro.props;
const { appStore } = ui[locale].home;
---

<section id="ios-app" class="home-section home-content app-store">
  <div class="app-store__panel">
    <div>
      <div class="home-eyebrow">{appStore.eyebrow}</div>
      <h2 class="home-h2">{appStore.liveHeading}</h2>
    </div>
    <div>
      <p>{appStore.liveBody}</p>
      <a class="app-store__badge" href={url} aria-label={appStore.badgeLabel}>
        <img
          src={`/app-store/download-${locale}-black.svg`}
          height="56"
          alt=""
        />
      </a>
    </div>
  </div>
</section>
