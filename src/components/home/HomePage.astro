---
import Base from '../../layouts/Base.astro';
import { appStoreUrl, ui, type Locale } from '../../i18n/ui';
import AppStore from './AppStore.astro';
import Hero from './Hero.astro';
import HomeFooter from './HomeFooter.astro';
import HomeNav from './HomeNav.astro';
import Philosophy from './Philosophy.astro';
import Screens from './Screens.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { title, metaDescription } = ui[locale].home;
---

<Base
  locale={locale}
  title={title}
  page=""
  variant="home"
  description={metaDescription}
>
  <Fragment slot="hero">
    <Hero locale={locale} />
  </Fragment>
  <Fragment slot="navigation">
    <HomeNav locale={locale} />
  </Fragment>
  <Screens locale={locale} />
  <Philosophy locale={locale} />
  <AppStore locale={locale} url={appStoreUrl} />
  <Fragment slot="footer">
    <HomeFooter locale={locale} />
  </Fragment>
</Base>
