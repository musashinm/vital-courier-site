---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { historyUrl, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry('privacy', locale);
if (!entry) throw new Error(`Missing privacy policy for ${locale}`);
const { Content } = await render(entry);
const strings = ui[locale];
const updated = entry.data.updated;
const updatedIso = updated.toISOString().slice(0, 10);
const updatedText = new Intl.DateTimeFormat(strings.dateLocale, {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(updated);
---

<Base locale={locale} title={entry.data.title} page="privacy">
  <article class="prose policy-prose">
    <h1>{entry.data.title}</h1>
    <p class="policy-meta">
      <span>
        {strings.lastUpdated}: <time datetime={updatedIso}>{updatedText}</time>
        <span class="policy-meta__separator" aria-hidden="true">
          {' '}
          ·{' '}
        </span>
      </span>
      <a href={historyUrl(locale)}>{strings.seeEveryChange}</a>
    </p>
    <Content />
  </article>
</Base>
