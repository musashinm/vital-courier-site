{
  "name": "vital-courier-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=America/Los_Angeles astro build && vitest run"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "mdast-util-from-markdown": "2.1.0",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4",
    "wrangler": "4.149.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
