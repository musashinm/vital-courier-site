{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vital-courier",
  "compatibility_date": "2026-10-08",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "vitalcourier.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
